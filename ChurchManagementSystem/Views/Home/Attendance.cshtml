<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Attendance</title>
    <script src="~/js/Home.js"></script>

    <script src="~/js/Attendance.js"></script>

   

</head>
<body>
    <div class="home-screen">
        <div class="home-card">
            <div class="home-card-body">
                @await Html.PartialAsync("_Header")
                <div id="content-attendance" class="content">
                        <div class="two-col">
                            <div class="card">
                            <div class="manage-box-attendance">
                                    <div class="search">
                                        <input type="text" id="memberSearch" placeholder="Search members..." value="" autocomplete="off">
                                    </div>
                                    @* <div class="cat-block">
                                        <div class="cat-label">Adults</div>
                                        <div class="chip-row">
                                            <button class="chip present" data-toggle="zg8n7m24" data-name="adrian lopez">✓ Adrian Lopez</button>
                                        </div>
                                    </div> *@
                                    <div class="cat-block">
                                        
                                        <div class="chip-row">
                                            <form class="attendance-edit-row" data-editform="1" id="memberForm-attendance" asp-controller="Home" asp-action="ManageAttendance" method="post">
                                            @Html.AntiForgeryToken()
                                                <div id="Visitors">
                                                    <form id="visitorForm" style="display:flex;gap:8px;margin-bottom:8px">
                                                        <input type="text" id="visitorName" placeholder="Visitor name">
                                                        <button type="button" id="btnAddVisitor" class="btn btn-default">Add</button>
                                                    </form>
                                                </div>
                                            <button type="submit" class="btn btn-save" id="saveAttendance">Save</button>
                                            </form>
                                        </div>
                                    </div>
                                    
                                </div>
                               
                            </div>
                        <div class="card avatar-hide">
                                <div class="manage-box-attendance">
                                    <div class="grid" id="grid"></div>

                                    <template id="avatar-template">
                                        <div class="avatar-card">
                                            <svg viewBox="0 0 100 100" class="avatar-icon">
                                                <circle cx="50" cy="36" r="16" />
                                                <path d="M18 88 C18 62 34 54 50 54 C66 54 82 62 82 88 Z" />
                                            </svg>
                                        </div>
                                    </template>
                                </div>

                            </div>
                        </div>
                </div>
            </div>

        </div>

    </div>
    @* <partial name="prompt" /> *@
@*     @await Html.PartialAsync("Prompt") *@
</body>
</html>