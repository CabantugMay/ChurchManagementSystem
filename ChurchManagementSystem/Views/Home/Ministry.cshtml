<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Ministry</title>
    <script src="~/js/Home.js"></script>

    <script src="~/js/Ministry.js"></script>

</head>
<body>
    <div class="home-screen">
        <div class="home-card">
            <div class="home-card-body">
                @await Html.PartialAsync("_Header")
                <div id="content" class="content">
                    <form id="ministryForm" class="assign-ministry" data-editform="1" asp-controller="Home" asp-action="AssignMinistry" method="post">
                        <div class="field-ministry hide">
                            <label class="font-label">Date</label>
                            <input type="date" id="mDate" name="mDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
                        </div>
                        <div id="mMinistry" class="field-ministry">
                        </div>
                        <div class="padding-10-lr">
                            <button type="submit" class="btn btn-assign-ministry">Add assignment</button>
                        </div>

                    </form>
                </div>
                </div>
            </div>
           
        </div>
        
</body>
</html>